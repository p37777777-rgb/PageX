{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "~/*": ["src/*"]
    }
  },
  "include": [
    ".wxt/**/*",
    "src/**/*",
    "tests/**/*",
    "vitest.config.ts",
    "playwright.config.ts",
    "mcp/**/*.ts",
    "wxt.config.ts"
  ],
  "exclude": ["tests/web-playground"]
}
