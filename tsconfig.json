{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    ".wxt/**/*",
    "src/**/*",
    "tests/**/*",
    "vitest.config.ts",
    "playwright.config.ts",
    "mcp/**/*.ts",
    "wxt.config.ts"
  ],
  "exclude": ["tests/web-playground"]
}
