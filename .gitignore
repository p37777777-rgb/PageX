# Whitelist: ignore everything at the repository root, then re-include only
# the project's own files. Anything new at the root (notes, HTML pages, agent
# workspaces, IDE folders) stays local until it is added to this list.
/*

# Source, tests, assets, licenses, and the MCP host
!/src/
!/tests/
!/public/
!/mcp/
!/LICENSES/

# Git and hook configuration (.husky/_/ is generated by `husky` on install)
!/.gitignore
!/.gitattributes
!/.husky/
/.husky/_/

# Package manifest and lockfile
!/package.json
!/pnpm-lock.yaml
!/.npmrc
!/.nvmrc

# Build, type-check, test, and UI tooling config
!/tsconfig*.json
!/*.config.ts
!/*.config.js
!/*.config.mjs
!/components.json
!/.editorconfig

# Project documentation
!/README.md

# Per-developer web-ext runner settings
/web-ext.config.ts

# --- Junk inside the whitelisted folders -------------------------------

# Dependencies and build output (tests/web-playground has its own package)
node_modules/
dist/
dist-ssr/
.output/
.wxt/
*.tsbuildinfo
*.js.map
*.d.ts.map
stats.html
stats-*.json

# Caches
.cache/
.vite/
.eslintcache

# Test output
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# Environment files and keys
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.local

# Packed extension artifacts
*.zip
*.crx
*.xpi

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.backup
*~
*.swp
*.swo

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
._*
Thumbs.db
Desktop.ini

# Template graphics the running extension does not import
public/wxt.svg
public/pagex-bot.svg
src/assets/react.svg
src/assets/pagex-bot.svg
